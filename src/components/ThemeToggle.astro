---
import { themeLabel } from '../scripts/theme'
---

<button
  id="theme-toggle"
  class="toggle"
  type="button"
  data-mode="system"
  title={themeLabel.system}
  aria-label={themeLabel.system}
>
  <svg class="icon icon-system" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="2.5" y="3.5" width="19" height="13" rx="2"></rect>
    <path d="M8.5 20.5h7M12 16.5v4"></path>
  </svg>
  <svg class="icon icon-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.2 5.2l1.4 1.4M17.4 17.4l1.4 1.4M18.8 5.2l-1.4 1.4M6.6 17.4l-1.4 1.4"></path>
  </svg>
  <svg class="icon icon-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M20.5 14.2A8.6 8.6 0 0 1 9.8 3.5a7.2 7.2 0 1 0 10.7 10.7z"></path>
  </svg>
</button>

<style>
  .toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: var(--radius-sm);
    color: var(--c-text-tertiary);
    transition: color var(--dur) var(--ease);
  }

  .toggle:hover {
    color: var(--c-text);
  }

  .icon {
    width: 15px;
    height: 15px;
  }

  .icon-light,
  .icon-dark {
    display: none;
  }

  .toggle[data-mode='light'] .icon-system,
  .toggle[data-mode='dark'] .icon-system {
    display: none;
  }

  .toggle[data-mode='light'] .icon-light {
    display: block;
  }

  .toggle[data-mode='dark'] .icon-dark {
    display: block;
  }
</style>

<script>
  import { readTheme, applyTheme, nextTheme, themeLabel, type Theme } from '../scripts/theme'

  const toggle = document.getElementById('theme-toggle') as HTMLButtonElement | null

  if (toggle) {
    let mode: Theme = readTheme()

    const paint = () => {
      toggle.dataset.mode = mode
      toggle.setAttribute('title', themeLabel[mode])
      toggle.setAttribute('aria-label', themeLabel[mode])
    }

    paint()

    toggle.addEventListener('click', () => {
      mode = nextTheme(mode)
      try {
        localStorage.setItem('theme', mode)
      } catch {
        /* ignore */
      }

      document.documentElement.classList.add('theme-anim')
      applyTheme(mode)
      paint()

      window.setTimeout(() => {
        document.documentElement.classList.remove('theme-anim')
      }, 240)
    })
  }
</script>
