---
/**
 * Shared back-navigation link.
 *
 * Replaces the old text arrow (「←」 glyph) with a drawn hairline arrow:
 * a long tail with a small head reads lighter and animates — the arrow
 * nudges left on hover while the label steps one gray darker.
 */
interface Props {
  href: string
  label: string
}

const { href, label } = Astro.props
---

<a class="back-link" href={href}>
  <svg
    class="back-arrow"
    width="20"
    height="10"
    viewBox="0 0 20 10"
    fill="none"
    aria-hidden="true"
  >
    <path d="M19 5H2M6.4 1.2 2 5l4.4 3.8" stroke="currentColor" stroke-width="1.3"></path>
  </svg>
  <span class="back-label">{label}</span>
</a>

<style>
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: var(--space-6);
    font-size: var(--fs-meta);
    color: var(--c-text-tertiary);
    transition: color var(--dur) var(--ease);
  }

  .back-arrow {
    flex: none;
    transition: transform var(--dur) var(--ease);
  }

  .back-label {
    letter-spacing: var(--ls-heading, 0.01em);
  }

  .back-link:hover {
    color: var(--c-text);
  }

  .back-link:hover .back-arrow {
    transform: translateX(-3px);
  }

  .back-link:focus-visible {
    outline: 1px solid var(--c-text-tertiary);
    outline-offset: 4px;
  }
</style>
