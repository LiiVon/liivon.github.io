---
import BaseLayout from '../../layouts/BaseLayout.astro'
import BackLink from '../../components/BackLink.astro'
import { sortedProjects } from '../../data/projects'
---

<BaseLayout
  title="Projects"
  description="Things I have built, explored, or am currently working on — C++ tooling, systems software, Linux internals and robotics experiments."
>
  <div class="wrap">
    <header class="page-head">
      <BackLink href="/" label="LiiVon" />
      <h1 class="page-title">Projects</h1>
      <p class="page-lede">
        A collection of things I have built, explored, or am currently working on.
      </p>
    </header>

    <section class="archive-col">
      <p class="archive-eyebrow tnum">{sortedProjects.length} projects</p>

      <div class="grid">
        {
          sortedProjects.map((project, i) => (
            <a class="cell" href={`/projects/${project.slug}`}>
              <span class="cell-top tnum">
                <span class="idx">{String(i + 1).padStart(2, '0')}</span>
                <span class="meta">
                  {project.year} · {project.status.toLowerCase()}
                </span>
              </span>

              <h2 class="cell-name">{project.name}</h2>
              <p class="cell-desc">{project.description}</p>

              <span class="cell-foot">
                <span class="tech tnum">{project.tech.join(' · ')}</span>
                <span class="cta" aria-hidden="true">
                  <svg width="16" height="10" viewBox="0 0 16 10" fill="none">
                    <path d="M1 5h13M9.6 1.2 14 5l-4.4 3.8" stroke="currentColor" stroke-width="1.3" />
                  </svg>
                </span>
              </span>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* One block per project. The whole cell is a single link into
     /projects/<slug>; the hairline border is the only ornament. */
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .cell {
    display: flex;
    flex-direction: column;
    padding: var(--space-5);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-sm);
    transition: border-color var(--dur) var(--ease);
  }

  .cell:hover {
    border-color: var(--c-text-tertiary);
  }

  .cell-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    color: var(--c-text-tertiary);
  }

  .idx {
    font-variant-numeric: tabular-nums;
  }

  .meta {
    white-space: nowrap;
  }

  .cell-name {
    margin-top: var(--space-4);
    font-size: var(--fs-subheading);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-heading);
    line-height: var(--lh-tight);
    color: var(--c-text);
  }

  .cell-desc {
    margin-top: var(--space-2);
    font-size: var(--fs-small);
    line-height: 1.65;
    color: var(--c-text-secondary);
  }

  /* The footer pins to the bottom so all cells share one baseline. */
  .cell-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: auto;
    padding-top: var(--space-5);
  }

  .tech {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    color: var(--c-text-tertiary);
  }

  .cta {
    flex: none;
    color: var(--c-text-tertiary);
    transition: color var(--dur) var(--ease), transform var(--dur) var(--ease);
  }

  .cell:hover .cta {
    color: var(--c-text);
    transform: translateX(3px);
  }

  @media (max-width: 760px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
